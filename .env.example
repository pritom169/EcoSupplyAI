# =============================================================================
# EcoSupplyAI - Environment Variables
# Copy this file to .env and fill in the values for your environment.
# =============================================================================

# -----------------------------------------------------------------------------
# Azure OpenAI - LLM backbone for chat, RAG, content generation, and agents
# -----------------------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-azure-openai-api-key>
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# -----------------------------------------------------------------------------
# Azure AI Search - Hybrid retrieval (keyword + vector) for RAG pipeline
# -----------------------------------------------------------------------------
AZURE_SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
AZURE_SEARCH_API_KEY=<your-azure-search-api-key>
AZURE_SEARCH_INDEX_NAME=ecosupplyai-docs

# -----------------------------------------------------------------------------
# Qdrant - Vector database for dense embedding storage and similarity search
# -----------------------------------------------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333

# -----------------------------------------------------------------------------
# Authentication - JWT token signing for API gateway
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=<generate-a-strong-random-secret>
JWT_ALGORITHM=HS256

# -----------------------------------------------------------------------------
# Redis - Caching layer, rate limiting, and event bus
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# OpenTelemetry - Distributed tracing and observability
# -----------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
PII_DETECTION_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
ALLOWED_ORIGINS=https://app.ecosupplyai.dev,http://localhost:3000

# -----------------------------------------------------------------------------
# PostgreSQL - Primary relational database
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://ecosupplyai:ecosupplyai@localhost:5432/ecosupplyai
POSTGRES_PASSWORD=ecosupplyai

